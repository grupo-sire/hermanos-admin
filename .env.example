# ==============================================================================
# BARBEARIA HERMANOS SYSTEM - ARCHITECTURE & ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# 📌 NOTA PARA O DESENVOLVEDOR (MIGRAÇÃO & ARQUITETURA):
# 
# Atualmente, parte destas variáveis está configurada nos Secrets das Edge Functions
# do Supabase (ex: vindi-proxy, cliente-auth, meta-webhook, chatbot-webhook).
# 
# 🚀 NA MIGRAÇÃO PARA O MARIADB / CLOUDWAYS (API Node.js ou PHP):
# Todas estas variáveis serão centralizadas 100% neste arquivo (.env) no servidor
# Cloudways (gerenciado via PM2 / Apache / Nginx), sem dependência de serverless.
#
# IMPORTANTE: Nunca envie chaves de API secretas (Vindi, Meta, Gemini, SendPulse)
# com o prefixo VITE_ para o frontend. Mantenha todas estritamente no backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VINDI API (RECORRÊNCIA, PLANOS INFINITE & CHECKOUT)
# Documentação: https://vindi.github.io/api-docs/
# Autenticação: Basic Auth no Backend (Basic Base64(API_KEY + ":"))
# ------------------------------------------------------------------------------
VINDI_API_KEY="seu_vindi_api_key_sandbox_ou_producao"
VINDI_ENV="sandbox" # ou "production"

# ------------------------------------------------------------------------------
# 2. META CLOUD API (WHATSAPP OFICIAL & META ADS)
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
# ------------------------------------------------------------------------------
# Access Token da Meta Cloud API (Envio de mensagens oficiais e templates WhatsApp)
META_WHATSAPP_TOKEN="seu_meta_whatsapp_access_token_aqui"

# ID do número de telefone registrado no WhatsApp Business Cloud API
META_PHONE_NUMBER_ID="seu_phone_number_id_aqui"

# Token de verificação configurado no Painel do Meta para validar Webhooks
META_WEBHOOK_VERIFY_TOKEN="seu_token_de_verificacao_webhook_aqui"

# Token de Acesso do Meta Ads (Leitura de métricas, campanhas e conversões)
META_ADS_TOKEN="seu_meta_ads_access_token_aqui"

# ID da Conta de Anúncios no Meta Ads (Ex: act_123456789)
META_ADS_ACCOUNT_ID="seu_ad_account_id_sem_prefixo_act"

# Secret de validação de Webhooks de Ads
ADS_WEBHOOK_SECRET="seu_ads_webhook_secret_aqui"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI 2.0 (IA / ASSISTENTE INTELIGENTE HELOÍSA)
# Documentação: https://ai.google.dev/docs
# ------------------------------------------------------------------------------
# Chave de API da Google Gemini (Processamento de linguagem natural do Chatbot)
GEMINI_API_KEY="sua_google_gemini_api_key_aqui"

# ------------------------------------------------------------------------------
# 4. SENDPULSE & RESEND (DISPARO DE E-MAILS TRANSACIONAIS & CÓDIGOS OTP)
# ------------------------------------------------------------------------------
# Credenciais da API REST do SendPulse (Disparo de códigos de verificação OTP)
SENDPULSE_API_USER_ID="seu_sendpulse_client_id_aqui"
SENDPULSE_API_SECRET="seu_sendpulse_client_secret_aqui"
SENDPULSE_FROM_EMAIL="relacionamento@barbeariahermanos.com.br"
SENDPULSE_FROM_NAME="Barbearia Hermanos"

# Resend API (Fallback para envio de e-mails transacionais / redefinição de senha)
RESEND_API_KEY="re_sua_resend_api_key_aqui"

# ------------------------------------------------------------------------------
# 5. INFRAESTRUTURA SUPABASE (ESTRUTURA ATUAL)
# Na migração MariaDB/Cloudways, estas variáveis serão substituídas por DB_HOST, DB_USER, DB_PASS, DB_NAME.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://khoeovszuixfwfkaaxaa.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_supabase_anon_key_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_supabase_service_role_key_privada_aqui"

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÕES FUTURAS DE BANCO DE DADOS (MARIADB / CLOUDWAYS)
# ------------------------------------------------------------------------------
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_NAME="sistemahermanos_db"
# DB_USER="hermanos_user"
# DB_PASS="sua_senha_segura_mariadb"
